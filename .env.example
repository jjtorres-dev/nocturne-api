NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=nocturne
DB_PASSWORD=nocturne
DB_NAME=nocturne

JWT_SECRET=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# Clave AES-256 para cifrar credenciales de Cuentas/Perfiles en reposo.
# Generar con: openssl rand -hex 32
# Si se pierde o se cambia, las credenciales ya guardadas quedan
# indescifrables — no hay forma de recuperarlas sin la clave original.
ENCRYPTION_KEY=change-this-generate-with-openssl-rand-hex-32

# Solo se usan para el script `npm run seed`
ADMIN_EMAIL=admin@nocturne.local
ADMIN_PASSWORD=change-this-password
